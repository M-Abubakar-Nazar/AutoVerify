@model AutoVerifyMVC.Models.BuyerDashboardViewModel
@{
    ViewData["Title"] = "Buyer Dashboard";
}

<main class="container py-5">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
        <div>
            <p class="text-uppercase small fw-bold text-primary mb-1">Buyer workspace</p>
            <h1 class="h2 mb-1">Find your next car</h1>
            <p class="text-muted mb-0">Browse vehicles and send inspection requests to sellers.</p>
        </div>
        <span class="badge text-bg-light border">@Model.Cars.Count vehicle listings</span>
    </div>

    <section class="row g-3 mb-4" aria-label="Inspection request summary">
        <div class="col-sm-6 col-lg-3"><div class="card"><div class="card-body"><div class="text-muted small">My total requests</div><div id="buyer-total-request-count" class="h3 fw-bold mb-0">@Model.TotalInquiries</div></div></div></div>
        <div class="col-sm-6 col-lg-3"><div class="card"><div class="card-body"><div class="text-muted small">Awaiting seller response</div><div id="buyer-pending-request-count" class="h3 fw-bold mb-0">@Model.PendingInquiries</div></div></div></div>
    </section>

    <section class="card shadow-sm mb-5" aria-labelledby="search-heading">
        <div class="card-body">
            <h2 id="search-heading" class="h5 mb-3">Search vehicles</h2>
            <form id="buyer-search-form" class="row g-3">
                <div class="col-lg-6">
                    <label class="form-label" for="search-term">Make or model</label>
                    <input id="search-term" name="searchTerm" class="form-control" placeholder="e.g. Toyota Corolla" />
                </div>
                <div class="col-sm-6 col-lg-4">
                    <label class="form-label" for="price-range">Price range</label>
                    <select id="price-range" name="priceRange" class="form-select">
                        <option value="">Any price</option><option value="under-20">Under 20 Lakh</option><option value="20-30">20–30 Lakh</option><option value="30-40">30–40 Lakh</option><option value="40-50">40–50 Lakh</option><option value="50-70">50–70 Lakh</option><option value="70-90">70–90 Lakh</option><option value="90-120">90–120 Lakh</option><option value="120-plus">Over 120 Lakh</option>
                    </select>
                </div>
                <div class="col-lg-2 d-flex align-items-end">
                    <button class="btn btn-primary w-100" type="submit">Search</button>
                </div>
            </form>
            <div id="search-feedback" class="small text-danger mt-2" role="status"></div>
        </div>
    </section>

    <section class="mb-5" aria-labelledby="cars-heading">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 id="cars-heading" class="h4 mb-0">Vehicle listings</h2>
            <span class="small text-muted">Current vehicle listings</span>
        </div>
        <div id="buyer-car-results" class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @await Html.PartialAsync("_BuyerCarCards", Model.Cars)
        </div>
    </section>

    <section class="card shadow-sm" aria-labelledby="inquiries-heading">
        <div class="card-body">
            <h2 id="inquiries-heading" class="h4 mb-3">My inspection requests</h2>
            <div id="buyer-inquiries">
                @await Html.PartialAsync("_BuyerInquiries", Model.Inquiries)
            </div>
        </div>
    </section>
</main>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script>
        (() => {
            const searchUrl = '@Url.Action("SearchCars", "Dashboard")';
            const requestUrl = '@Url.Action("RequestInspection", "Dashboard")';
            const inquiriesUrl = '@Url.Action("BuyerInquiries", "Dashboard")';

            $('#buyer-search-form').on('submit', function (event) {
                event.preventDefault();
                $('#search-feedback').text('');
                $.get(searchUrl, $(this).serialize())
                    .done(html => $('#buyer-car-results').html(html))
                    .fail(xhr => $('#search-feedback').text(xhr.responseText || 'Could not search vehicles.'));
            });

            $('#buyer-car-results').on('submit', '.js-inquiry-form', function (event) {
                event.preventDefault();
                const form = $(this);
                const feedback = form.find('.js-inquiry-feedback');
                feedback.removeClass('text-danger text-success').text('Sending…');
                $.post(requestUrl, form.serialize())
                    .done(result => {
                        feedback.addClass('text-success').text(result.message);
                        form[0].reset();
                        $('#buyer-total-request-count').text(Number($('#buyer-total-request-count').text()) + 1);
                        $('#buyer-pending-request-count').text(Number($('#buyer-pending-request-count').text()) + 1);
                        $.get(inquiriesUrl).done(html => $('#buyer-inquiries').html(html));
                    })
                    .fail(xhr => {
                        const result = xhr.responseJSON;
                        feedback.addClass('text-danger').text(result?.message || 'Could not send the inspection request.');
                    });
            });

            const syncStatuses = () => $.get('@Url.Action("CarStatuses", "Home")').done(items => items.forEach(item => {
                const badge = $(`[data-car-status-id="${item.id}"]`);
                if (!badge.length) return;
                badge.text(item.status).removeClass('text-bg-success text-bg-warning text-bg-secondary text-bg-danger')
                    .addClass(item.status === 'Sold' ? 'text-bg-danger' : item.status === 'Unavailable' ? 'text-bg-secondary' : item.status === 'Reserved' ? 'text-bg-warning' : 'text-bg-success');
                const card = badge.closest('.card');
                if (item.status === 'Available') {
                    if (!card.find('.js-inquiry-form').length && item.sellerId) location.reload();
                } else {
                    card.find('.js-inquiry-form').remove();
                }
            }));
            syncStatuses(); window.setInterval(syncStatuses, 10000);
        })();
    </script>
}
