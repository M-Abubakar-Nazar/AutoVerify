@model IReadOnlyList<AutoVerifyMVC.Models.CarListingViewModel>

@if (Model.Count == 0)
{
    <div class="col-12">
        <div class="alert alert-light border mb-0">There are no listings to display yet.</div>
    </div>
}
else
{
    foreach (var car in Model)
    {
        var defaultImageUrl = Url.Content("~/assets/images/Default.png");
        var imageUrl = string.IsNullOrWhiteSpace(car.ImagePath) ? defaultImageUrl : car.ImagePath;
        <div class="col d-flex">
            <article class="card h-100 w-100 d-flex flex-column shadow-sm overflow-hidden">
                <img class="w-100 flex-shrink-0" style="height:210px;object-fit:cover" src="@imageUrl" onerror="this.onerror=null;this.src='@defaultImageUrl';" alt="@car.ModelYear @car.Make @car.Model @car.Trim" />
                <div class="card-body d-flex flex-column">
                    <div class="d-flex justify-content-between gap-2 align-items-center mb-2">
                        <span class="badge text-bg-light border">@car.ModelYear</span>
                        <span id="listing-status-@car.Id" class="badge @(car.Status == "Sold" ? "text-bg-danger" : car.Status == "Unavailable" ? "text-bg-secondary" : car.Status == "Reserved" ? "text-bg-warning" : "text-bg-success")">@car.Status</span>
                    </div>
                    <h2 class="h5 card-title">@car.ModelYear @car.Make @car.Model @car.Trim</h2>
                    <p class="small text-muted mb-2">@car.Engine · @car.Transmission · @car.MileageKm.ToString("N0") km · @car.FuelType</p>
                    <p class="card-text">@car.Description</p>
                    <p class="small text-muted">Seller: @car.SellerName</p>
                    @if (car.Status == "Removed")
                    {
                        <p class="small text-danger mt-3 mb-0">This listing was removed by an administrator.</p>
                    }
                    else
                    {
                        <form class="js-listing-status-form mt-3">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="ListingId" value="@car.Id" />
                            <label class="form-label small" for="status-choice-@car.Id">Update status</label>
                            <div class="input-group input-group-sm">
                                <select id="status-choice-@car.Id" name="Status" class="form-select">
                                    <option value="Available" selected="@(car.Status == "Available")">Available</option>
                                    <option value="Reserved" selected="@(car.Status == "Reserved")">Reserved</option>
                                    <option value="Unavailable" selected="@(car.Status == "Unavailable")">Unavailable</option>
                                    <option value="Sold" selected="@(car.Status == "Sold")">Sold</option>
                                </select>
                                <button class="btn btn-outline-primary" type="submit">Save</button>
                            </div>
                            <div class="js-status-feedback small mt-2" role="status"></div>
                        </form>
                    }
                    <strong class="text-primary mt-auto pt-3">PKR @car.Price.ToString("N0")</strong>
                </div>
            </article>
        </div>
    }
}
