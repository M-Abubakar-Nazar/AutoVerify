@model IReadOnlyList<AutoVerifyMVC.Models.AdminUserRowViewModel>
@{
    var userSearch = ViewData["UserSearch"] as string ?? string.Empty;
}

@if (Model.Count == 0)
{
    <span class="d-none" data-admin-user-count="0"></span>
    <p class="text-muted mb-0">No matching accounts were found.</p>
}
else
{
    <span class="d-none" data-admin-user-count="@Model.Count"></span>
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Account status</th><th>Action</th></tr></thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>@user.FullName</td>
                        <td>@user.Email</td>
                        <td><span class="badge text-bg-light border">@user.Roles</span></td>
                        <td><span class="badge @(user.IsSuspended ? "text-bg-danger" : "text-bg-success")" data-account-status>@(user.IsSuspended ? "Suspended" : "Active")</span></td>
                        <td>
                            @if (!user.Roles.Contains("Administrator", StringComparison.OrdinalIgnoreCase))
                            {
                                <form asp-action="SetUserSuspension" method="post" class="d-inline js-admin-suspension-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="userId" value="@user.Id" />
                                    <input type="hidden" name="userSearch" value="@userSearch" />
                                    <input type="hidden" name="suspend" value="@(!user.IsSuspended)" />
                                    <button class="btn btn-sm @(user.IsSuspended ? "btn-outline-success" : "btn-outline-danger")" type="submit">@(user.IsSuspended ? "Restore" : "Suspend")</button>
                                </form>
                            }
                            else
                            {
                                <span class="small text-muted">Admin accounts protected</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
