@model AutoVerifyMVC.Models.SellerDashboardViewModel
@{
    ViewData["Title"] = "Seller Dashboard";
}

<main class="container py-5">
    <div class="mb-4">
        <p class="text-uppercase small fw-bold text-primary mb-1">Seller workspace</p>
        <h1 class="h2 mb-1">Manage your vehicle listings</h1>
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <p class="text-muted mb-0">Review and manage your vehicle listings and inspection requests.</p>
            <a class="btn btn-primary" href="#add-vehicle-form">+ Add a vehicle</a>
        </div>
    </div>

    @if (TempData["SellerMessage"] is string message)
    {
        <div class="alert alert-success">@message</div>
    }

    <section id="add-vehicle-form" class="card shadow-sm mb-5" aria-labelledby="add-listing-heading">
        <div class="card-body">
            <h2 id="add-listing-heading" class="h4 mb-3">Add a vehicle listing</h2>
            <form asp-action="CreateListing" method="post" class="row g-3">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="text-danger"></div>
                <div class="col-md-4"><label asp-for="CreateListing.Make" class="form-label"></label><input asp-for="CreateListing.Make" class="form-control" /><span asp-validation-for="CreateListing.Make" class="text-danger small"></span></div>
                <div class="col-md-4"><label asp-for="CreateListing.Model" class="form-label"></label><input asp-for="CreateListing.Model" class="form-control" /><span asp-validation-for="CreateListing.Model" class="text-danger small"></span></div>
                <div class="col-md-4"><label asp-for="CreateListing.Trim" class="form-label"></label><input asp-for="CreateListing.Trim" class="form-control" /></div>
                <div class="col-md-2"><label asp-for="CreateListing.ModelYear" class="form-label">Year</label><input asp-for="CreateListing.ModelYear" class="form-control" /><span asp-validation-for="CreateListing.ModelYear" class="text-danger small"></span></div>
                <div class="col-md-3"><label asp-for="CreateListing.Price" class="form-label">Price (PKR)</label><input asp-for="CreateListing.Price" class="form-control" /><span asp-validation-for="CreateListing.Price" class="text-danger small"></span></div>
                <div class="col-md-3"><label asp-for="CreateListing.MileageKm" class="form-label">Mileage (km)</label><input asp-for="CreateListing.MileageKm" class="form-control" /></div>
                <div class="col-md-4"><label asp-for="CreateListing.Engine" class="form-label"></label><input asp-for="CreateListing.Engine" class="form-control" /></div>
                <div class="col-md-4"><label asp-for="CreateListing.Transmission" class="form-label"></label><input asp-for="CreateListing.Transmission" class="form-control" /></div>
                <div class="col-md-4"><label asp-for="CreateListing.FuelType" class="form-label">Fuel type</label><input asp-for="CreateListing.FuelType" class="form-control" /></div>
                <div class="col-md-6"><label asp-for="CreateListing.ImagePath" class="form-label">Vehicle photo</label><select asp-for="CreateListing.ImagePath" class="form-select"><option value="/assets/images/Default.png">Use default photo</option><option value="/assets/images/alto.png">Suzuki Alto</option><option value="/assets/images/civic.png">Honda Civic</option><option value="/assets/images/corolla.png">Toyota Corolla</option><option value="/assets/images/kia.png">Kia Sportage</option><option value="/assets/images/LandCruiser.png">Toyota Land Cruiser</option><option value="/assets/images/Sonata%20Linen.png">Hyundai Sonata</option></select><span asp-validation-for="CreateListing.ImagePath" class="text-danger small"></span></div>
                <div class="col-12"><label asp-for="CreateListing.Description" class="form-label"></label><textarea asp-for="CreateListing.Description" class="form-control" rows="3"></textarea><span asp-validation-for="CreateListing.Description" class="text-danger small"></span></div>
                <div class="col-12"><button class="btn btn-primary" type="submit">Publish listing</button></div>
            </form>
        </div>
    </section>

    <section class="row g-3 mb-5" aria-label="Dashboard summary">
        <div class="col-sm-6 col-xl-2"><div class="card h-100"><div class="card-body"><div class="text-muted small">Available cars</div><div class="display-6 fw-bold">@Model.ActiveListings</div></div></div></div>
        <div class="col-sm-6 col-xl-2"><div class="card h-100"><div class="card-body"><div class="text-muted small">Reserved</div><div class="display-6 fw-bold">@Model.ReservedListings</div></div></div></div>
        <div class="col-sm-6 col-xl-2"><div class="card h-100"><div class="card-body"><div class="text-muted small">Unavailable</div><div class="display-6 fw-bold">@Model.UnavailableListings</div></div></div></div>
        <div class="col-sm-6 col-xl-2"><div class="card h-100"><div class="card-body"><div class="text-muted small">Sold</div><div class="display-6 fw-bold">@Model.SoldListings</div></div></div></div>
        <div class="col-sm-6 col-xl-2"><div class="card h-100"><div class="card-body"><div class="text-muted small">Total requests</div><div class="display-6 fw-bold">@Model.TotalInquiries</div></div></div></div>
        <div class="col-sm-6 col-xl-2"><div class="card h-100 border-warning"><div class="card-body"><div class="text-muted small">Pending requests</div><div class="display-6 fw-bold">@Model.PendingInquiries</div></div></div></div>
    </section>

    <section class="mb-5" aria-labelledby="listings-heading">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 id="listings-heading" class="h4 mb-0">Vehicle listings</h2>
            <span class="small text-muted">@Model.Cars.Count listings</span>
        </div>
        <div id="seller-car-results" class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @await Html.PartialAsync("_SellerCarCards", Model.Cars)
        </div>
    </section>

    <section class="card shadow-sm" aria-labelledby="requests-heading">
        <div class="card-body">
            <h2 id="requests-heading" class="h4 mb-3">Inspection requests</h2>
            @await Html.PartialAsync("_SellerInquiries", Model.Inquiries)
        </div>
    </section>
</main>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script>
        (() => {
            const statusUrl = '@Url.Action("UpdateListingStatus", "Dashboard")';

            $('#seller-car-results').on('submit', '.js-listing-status-form', function (event) {
                event.preventDefault();
                const form = $(this);
                const listingId = form.find('[name="ListingId"]').val();
                const status = form.find('[name="Status"]').val();
                const feedback = form.find('.js-status-feedback');
                feedback.removeClass('text-danger text-success').text('Saving…');

                $.ajax({
                    url: statusUrl,
                    method: 'POST',
                    data: form.serialize()
                }).done(result => {
                    const badge = $('#listing-status-' + listingId);
                    badge.text(result.status)
                        .removeClass('text-bg-success text-bg-warning text-bg-secondary text-bg-danger')
                        .addClass(result.status === 'Sold' ? 'text-bg-danger' : result.status === 'Unavailable' ? 'text-bg-secondary' : result.status === 'Reserved' ? 'text-bg-warning' : 'text-bg-success');
                    feedback.addClass('text-success').text(result.message);
                }).fail(xhr => {
                    const result = xhr.responseJSON;
                    feedback.addClass('text-danger').text(result?.message || 'Could not update listing status.');
                });
            });
        })();
    </script>
}
