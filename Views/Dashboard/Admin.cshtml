@model AutoVerifyMVC.Models.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin dashboard";
}

<main class="container py-5">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
        <div><p class="text-uppercase small fw-bold text-primary mb-1">Administration</p><h1 class="h2 mb-1">Platform overview</h1><p class="text-muted mb-0">Live account, vehicle, and inspection activity.</p></div>
        <span class="badge text-bg-success">System online</span>
    </div>

    @if (TempData["AdminMessage"] is string message)
    {
        <div class="alert alert-success">@message</div>
    }
    @if (TempData["AdminError"] is string error)
    {
        <div class="alert alert-danger">@error</div>
    }
    <div id="admin-ajax-message" aria-live="polite"></div>

    <section class="card shadow-sm mb-5" aria-labelledby="create-inspector-heading">
        <div class="card-body">
            <h2 id="create-inspector-heading" class="h4">Create an Inspector account</h2>
            <p class="small text-muted">Use a temporary password and share it with the inspector securely.</p>
            <form asp-action="CreateInspector" method="post" class="row g-3 js-create-inspector-form">
                @Html.AntiForgeryToken()
                <div class="col-md-4"><label class="form-label" for="inspector-name">Full name</label><input class="form-control" id="inspector-name" name="FullName" maxlength="200" required /></div>
                <div class="col-md-4"><label class="form-label" for="inspector-email">Email</label><input class="form-control" id="inspector-email" name="Email" type="email" required /></div>
                <div class="col-md-4"><label class="form-label" for="inspector-password">Temporary password</label><input class="form-control" id="inspector-password" name="TemporaryPassword" type="password" minlength="8" autocomplete="new-password" required /></div>
                <div class="col-12"><button class="btn btn-primary" type="submit">Create Inspector</button></div>
            </form>
        </div>
    </section>

    <section class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-3 mb-5" aria-label="Platform statistics">
        <div class="col"><div class="card h-100"><div class="card-body"><div class="small text-muted">Registered users</div><div class="display-6 fw-bold">@Model.TotalUsers</div><div class="small text-muted">@Model.BuyerCount buyers · @Model.SellerCount sellers</div><div class="small text-muted">@Model.InspectorCount inspectors · @Model.AdministratorCount admins</div></div></div></div>
        <div class="col"><div class="card h-100"><div class="card-body"><div class="small text-muted">Vehicle listings</div><div class="display-6 fw-bold">@Model.TotalListings</div><div class="small text-muted">@Model.AvailableListings currently available</div></div></div></div>
        <div class="col"><div class="card h-100"><div class="card-body"><div class="small text-muted">Inspection requests</div><div class="display-6 fw-bold">@Model.TotalInquiries</div><div class="small text-muted">@Model.PendingInquiries pending</div></div></div></div>
        <div class="col"><div class="card h-100"><div class="card-body"><div class="small text-muted">Reports completed</div><div class="display-6 fw-bold">@Model.CompletedInspections</div><div class="small text-muted">@Model.ActiveInspections in progress</div></div></div></div>
    </section>

    <section class="card shadow-sm mb-5" aria-labelledby="users-heading">
        <div class="card-body">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
                <h2 id="users-heading" class="h4 mb-0">Accounts</h2>
                <span id="admin-account-count" class="small text-muted">Showing @Model.Users.Count of @Model.TotalUsers accounts</span>
            </div>
            <form id="admin-user-search-form" asp-action="Admin" method="get" class="row g-2 mb-3">
                <div class="col-sm-8 col-lg-5">
                    <label class="visually-hidden" for="user-search">Search accounts</label>
                    <input id="user-search" name="userSearch" value="@Model.UserSearch" class="form-control" placeholder="Search name or email" />
                </div>
                <div class="col-auto"><button class="btn btn-outline-primary" type="submit">Search</button></div>
                @if (!string.IsNullOrWhiteSpace(Model.UserSearch))
                {
                    <div class="col-auto"><button id="clear-admin-search" class="btn btn-outline-secondary" type="button">Clear</button></div>
                }
            </form>
            <div id="admin-users-results">
                @await Html.PartialAsync("_AdminUsersTable", Model.Users, new ViewDataDictionary(ViewData) { ["UserSearch"] = Model.UserSearch })
            </div>
        </div>
    </section>

    <section class="card shadow-sm" aria-labelledby="requests-heading">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3"><h2 id="requests-heading" class="h4 mb-0">Inspection activity</h2><span class="small text-muted">Most recent @Model.Inquiries.Count</span></div>
            @if (Model.Inquiries.Count == 0)
            {
                <p class="text-muted mb-0">No inspection requests have been submitted.</p>
            }
            else
            {
                <div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Vehicle</th><th>Buyer</th><th>Seller</th><th>Inspector</th><th>Status</th><th>Requested</th><th>Manage</th></tr></thead><tbody>
                    @foreach (var inquiry in Model.Inquiries)
                    {
                        var statusClass = inquiry.Status == "Pending" ? "text-bg-warning" : inquiry.Status == "Completed" ? "text-bg-success" : inquiry.Status == "Cancelled" ? "text-bg-secondary" : "text-bg-primary";
                        <tr>
                            <td>@inquiry.VehicleName</td><td>@inquiry.BuyerName</td><td>@inquiry.SellerName</td><td data-inspector-name>@inquiry.InspectorName</td>
                            <td><span class="badge @statusClass" data-inquiry-status>@inquiry.Status</span></td>
                            <td>@inquiry.CreatedAtUtc.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</td>
                            <td>
                                @if (inquiry.Status == "Cancelled")
                                {
                                    <form asp-action="SetInquiryCancellation" method="post" class="d-inline js-admin-inquiry-form">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="inquiryId" value="@inquiry.Id" />
                                        <input type="hidden" name="cancelled" value="false" />
                                        <button class="btn btn-sm btn-outline-primary" type="submit">Reopen</button>
                                    </form>
                                }
                                else if (inquiry.Status != "Completed")
                                {
                                    <form asp-action="SetInquiryCancellation" method="post" class="d-inline js-admin-inquiry-form">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="inquiryId" value="@inquiry.Id" />
                                        <input type="hidden" name="cancelled" value="true" />
                                        <button class="btn btn-sm btn-outline-danger" type="submit">Cancel</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody></table></div>
            }
        </div>
    </section>

    <section class="card shadow-sm mt-5" aria-labelledby="listings-heading">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3"><h2 id="listings-heading" class="h4 mb-0">Vehicle listings</h2><span class="small text-muted">Showing @Model.Listings.Count of @Model.TotalListings</span></div>
            @if (Model.Listings.Count == 0)
            {
                <p class="text-muted mb-0">No vehicles are listed yet.</p>
            }
            else
            {
                <div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Vehicle</th><th>Seller</th><th>Price</th><th>Status</th><th>Listed</th><th>Manage</th></tr></thead><tbody>
                    @foreach (var listing in Model.Listings)
                    {
                        var defaultImage = Url.Content("~/assets/images/Default.png");
                        var imageUrl = string.IsNullOrWhiteSpace(listing.ImagePath) ? defaultImage : listing.ImagePath;
                        var statusClass = listing.Status == "Available" ? "text-bg-success" : listing.Status == "Sold" ? "text-bg-danger" : listing.Status == "Removed" ? "text-bg-dark" : listing.Status == "Unavailable" ? "text-bg-secondary" : "text-bg-warning";
                        <tr>
                            <td><div class="d-flex align-items-center gap-2"><img src="@imageUrl" onerror="this.onerror=null;this.src='@defaultImage';" alt="" width="72" height="48" style="object-fit:cover" /><strong>@listing.VehicleName</strong></div></td>
                            <td>@listing.SellerName</td><td>PKR @listing.Price.ToString("N0")</td><td><span class="badge @statusClass" data-listing-status>@listing.Status</span></td>
                            <td>@listing.CreatedAtUtc.ToLocalTime().ToString("MMM d, yyyy")</td>
                            <td>
                                <form asp-action="SetListingRemoval" method="post" class="d-inline js-admin-listing-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="listingId" value="@listing.Id" />
                                    <input type="hidden" name="removed" value="@(!listing.IsRemoved)" />
                                    <button class="btn btn-sm @(listing.IsRemoved ? "btn-outline-primary" : "btn-outline-danger")" type="submit">@(listing.IsRemoved ? "Restore" : "Remove")</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody></table></div>
            }
        </div>
    </section>
</main>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script>
        (() => {
            const usersUrl = '@Url.Action("AdminUsers", "Dashboard")';

            const showMessage = (message, isError = false) => {
                $('#admin-ajax-message').html($('<div>', {
                    class: `alert ${isError ? 'alert-danger' : 'alert-success'}`,
                    role: isError ? 'alert' : 'status',
                    text: message
                }));
            };

            const failureMessage = xhr => xhr.responseJSON?.message || 'The request could not be completed.';

            const searchUsers = () => $.get(usersUrl, { userSearch: $('#user-search').val() })
                .done(html => {
                    $('#admin-users-results').html(html);
                    const count = $('#admin-users-results [data-admin-user-count]').data('admin-user-count') || 0;
                    const query = $('#user-search').val().trim();
                    $('#admin-account-count').text(query ? `Showing ${count} matching accounts` : `Showing ${count} accounts`);
                })
                .fail(xhr => showMessage(failureMessage(xhr), true));

            $('#admin-user-search-form').on('submit', function (event) {
                event.preventDefault();
                searchUsers();
            });

            $('#clear-admin-search').on('click', () => {
                $('#user-search').val('');
                searchUsers();
            });

            let searchTimer;
            $('#user-search').on('input', () => {
                clearTimeout(searchTimer);
                searchTimer = setTimeout(searchUsers, 250);
            });

            $('#admin-users-results').on('submit', '.js-admin-suspension-form', function (event) {
                event.preventDefault();
                const form = $(this);
                $.post(form.attr('action'), form.serialize())
                    .done(result => {
                        const suspended = result.suspended;
                        const row = form.closest('tr');
                        row.find('[data-account-status]')
                            .text(suspended ? 'Suspended' : 'Active')
                            .toggleClass('text-bg-danger', suspended)
                            .toggleClass('text-bg-success', !suspended);
                        form.find('[name="suspend"]').val(!suspended);
                        form.find('button').text(suspended ? 'Restore' : 'Suspend')
                            .toggleClass('btn-outline-danger', !suspended)
                            .toggleClass('btn-outline-success', suspended);
                        showMessage(result.message);
                    })
                    .fail(xhr => showMessage(failureMessage(xhr), true));
            });

            $('.js-create-inspector-form').on('submit', function (event) {
                event.preventDefault();
                const form = $(this);
                $.post(form.attr('action'), form.serialize())
                    .done(result => { form[0].reset(); showMessage(result.message); })
                    .fail(xhr => showMessage(failureMessage(xhr), true));
            });

            $('.table').on('submit', '.js-admin-listing-form', function (event) {
                event.preventDefault();
                const form = $(this);
                const removing = form.find('[name="removed"]').val().toLowerCase() === 'true';
                if (removing && !window.confirm('Remove this listing from public browsing?')) return;
                $.ajax({ url: form.attr('action'), method: 'POST', data: form.serialize() })
                    .done(result => {
                        const row = form.closest('tr');
                        row.find('[data-listing-status]').text(result.status)
                            .removeClass('text-bg-success text-bg-danger text-bg-secondary text-bg-dark text-bg-warning')
                            .addClass(result.removed ? 'text-bg-dark' : 'text-bg-secondary');
                        form.find('[name="removed"]').val(!result.removed);
                        form.find('button').text(result.removed ? 'Restore' : 'Remove')
                            .toggleClass('btn-outline-danger', !result.removed)
                            .toggleClass('btn-outline-primary', result.removed);
                        showMessage(result.message);
                    })
                    .fail(xhr => showMessage(failureMessage(xhr), true));
            });

            $('.table').on('submit', '.js-admin-inquiry-form', function (event) {
                event.preventDefault();
                const form = $(this);
                const cancelling = form.find('[name="cancelled"]').val().toLowerCase() === 'true';
                if (cancelling && !window.confirm('Cancel this inspection request?')) return;
                $.post(form.attr('action'), form.serialize())
                    .done(result => {
                        const row = form.closest('tr');
                        row.find('[data-inquiry-status]').text(result.status)
                            .removeClass('text-bg-warning text-bg-success text-bg-secondary text-bg-primary')
                            .addClass(result.status === 'Cancelled' ? 'text-bg-secondary' : 'text-bg-warning');
                        row.find('[data-inspector-name]').text(result.inspectorName);
                        form.find('[name="cancelled"]').val(!result.cancelled);
                        form.find('button').text(result.cancelled ? 'Reopen' : 'Cancel')
                            .toggleClass('btn-outline-danger', !result.cancelled)
                            .toggleClass('btn-outline-primary', result.cancelled);
                        showMessage(result.message);
                    })
                    .fail(xhr => showMessage(failureMessage(xhr), true));
            });
        })();
    </script>
}
