@model AutoVerifyMVC.Models.InspectorDashboardViewModel
@{
    ViewData["Title"] = "Inspector dashboard";
    var defaultImage = Url.Content("~/assets/images/Default.png");
}

<main id="inspector-dashboard" class="container py-5">
    <div class="mb-4"><p class="text-uppercase small fw-bold text-primary mb-1">Inspector workspace</p><h1 class="h2 mb-1">Inspection desk</h1><p class="text-muted mb-0">Claim a buyer request, inspect the vehicle, and submit a structured report.</p></div>

    @if (TempData["InspectorMessage"] is string message)
    {
        <div class="alert alert-success" role="status">@message</div>
    }
    @if (TempData["InspectorError"] is string error)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }

    <section class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-3 mb-5" aria-label="Inspection statistics">
        <div class="col"><div class="card h-100"><div class="card-body"><div class="text-muted small">Unassigned requests</div><div class="display-6 fw-bold">@Model.AvailableInspections</div></div></div></div>
        <div class="col"><div class="card h-100"><div class="card-body"><div class="text-muted small">My active inspections</div><div class="display-6 fw-bold">@Model.ActiveInspections</div></div></div></div>
        <div class="col"><div class="card h-100"><div class="card-body"><div class="text-muted small">My reports completed</div><div class="display-6 fw-bold">@Model.CompletedInspections</div></div></div></div>
    </section>

    <section class="mb-5" aria-labelledby="queue-heading">
        <div class="d-flex justify-content-between align-items-center mb-3"><h2 id="queue-heading" class="h4 mb-0">Available inspection requests</h2><span class="small text-muted">@Model.Queue.Count waiting</span></div>
        @if (Model.Queue.Count == 0)
        {
            <div class="alert alert-light border">There are no unassigned requests right now.</div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                @foreach (var inspection in Model.Queue)
                {
                    var imageUrl = string.IsNullOrWhiteSpace(inspection.ImagePath) ? defaultImage : inspection.ImagePath;
                    <div class="col d-flex"><article class="card h-100 w-100 shadow-sm overflow-hidden">
                        <img src="@imageUrl" onerror="this.onerror=null;this.src='@defaultImage';" alt="@inspection.VehicleName" style="height:210px;width:100%;object-fit:cover" />
                        <div class="card-body d-flex flex-column">
                            <span class="badge text-bg-warning align-self-start mb-2">Pending assignment</span>
                            <h3 class="h5">@inspection.VehicleName</h3>
                            <p class="small text-muted mb-1">Buyer: @inspection.BuyerName</p>
                            <p class="small text-muted mb-1">Seller: @inspection.SellerName</p>
                            <p class="small text-muted">Requested @inspection.CreatedAtUtc.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</p>
                            @if (!string.IsNullOrWhiteSpace(inspection.Message))
                            {
                                <p class="small">Buyer note: @inspection.Message</p>
                            }
                            <form asp-action="ClaimInspection" method="post" class="mt-auto js-inspector-claim-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="inquiryId" value="@inspection.Id" />
                                <button class="btn btn-primary w-100" type="submit">Claim inspection</button>
                            </form>
                        </div>
                    </article></div>
                }
            </div>
        }
    </section>

    <section aria-labelledby="assigned-heading">
        <div class="d-flex justify-content-between align-items-center mb-3"><h2 id="assigned-heading" class="h4 mb-0">My inspections and reports</h2><span class="small text-muted">@Model.AssignedInspections.Count assigned</span></div>
        @if (Model.AssignedInspections.Count == 0)
        {
            <div class="alert alert-light border">Claim a request to start an inspection.</div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-md-2 g-4">
                @foreach (var inspection in Model.AssignedInspections)
                {
                    var imageUrl = string.IsNullOrWhiteSpace(inspection.ImagePath) ? defaultImage : inspection.ImagePath;
                    <div class="col d-flex"><article class="card h-100 w-100 shadow-sm overflow-hidden">
                        <img src="@imageUrl" onerror="this.onerror=null;this.src='@defaultImage';" alt="@inspection.VehicleName" style="height:210px;width:100%;object-fit:cover" />
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between gap-2"><h3 class="h5">@inspection.VehicleName</h3><span class="badge @(inspection.Status == "Completed" ? "text-bg-success" : "text-bg-primary")">@inspection.Status</span></div>
                            <p class="small text-muted">Buyer: @inspection.BuyerName · Seller: @inspection.SellerName</p>
                            @if (inspection.Status == "In Progress")
                            {
                                <form asp-action="SubmitInspectionReport" method="post" class="mt-auto js-inspector-report-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="InquiryId" value="@inspection.Id" />
                                    <div class="row g-2">
                                        <div class="col-sm-6"><label class="form-label small" for="engine-@inspection.Id">Engine</label><select id="engine-@inspection.Id" name="EngineCondition" class="form-select" required><option value="">Select condition</option><option>Good</option><option>Needs attention</option><option>Poor</option></select></div>
                                        <div class="col-sm-6"><label class="form-label small" for="transmission-@inspection.Id">Transmission</label><select id="transmission-@inspection.Id" name="TransmissionCondition" class="form-select" required><option value="">Select condition</option><option>Good</option><option>Needs attention</option><option>Poor</option></select></div>
                                        <div class="col-sm-6"><label class="form-label small" for="body-@inspection.Id">Body</label><select id="body-@inspection.Id" name="BodyCondition" class="form-select" required><option value="">Select condition</option><option>Good</option><option>Needs attention</option><option>Poor</option></select></div>
                                        <div class="col-sm-6"><label class="form-label small" for="brakes-@inspection.Id">Brakes</label><select id="brakes-@inspection.Id" name="BrakesCondition" class="form-select" required><option value="">Select condition</option><option>Good</option><option>Needs attention</option><option>Poor</option></select></div>
                                        <div class="col-12"><label class="form-label small" for="notes-@inspection.Id">Report notes (optional)</label><textarea id="notes-@inspection.Id" name="InspectionNotes" class="form-control" maxlength="2000" rows="3"></textarea></div>
                                    </div>
                                    <button class="btn btn-primary mt-3" type="submit">Submit inspection report</button>
                                </form>
                            }
                            else
                            {
                                <div class="border rounded p-3 mt-auto">
                                    <div class="small"><strong>Engine:</strong> @inspection.EngineCondition · <strong>Transmission:</strong> @inspection.TransmissionCondition</div>
                                    <div class="small"><strong>Body:</strong> @inspection.BodyCondition · <strong>Brakes:</strong> @inspection.BrakesCondition</div>
                                    @if (!string.IsNullOrWhiteSpace(inspection.InspectionNotes))
                                    {
                                        <p class="small mb-0 mt-2">@inspection.InspectionNotes</p>
                                    }
                                    <p class="small text-muted mb-0 mt-2">Completed @inspection.CompletedAtUtc?.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</p>
                                </div>
                            }
                        </div>
                    </article></div>
                }
            </div>
        }
    </section>
</main>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script>
        (() => {
            const dashboardUrl = '@Url.Action("Inspector", "Dashboard")';

            const showMessage = (message, isError = false) => {
                $('#inspector-ajax-message').remove();
                $('<div>', {
                    id: 'inspector-ajax-message',
                    class: `alert ${isError ? 'alert-danger' : 'alert-success'} mb-4`,
                    role: isError ? 'alert' : 'status',
                    text: message
                }).prependTo('#inspector-dashboard');
            };

            const refreshDashboard = message => $.get(dashboardUrl).done(html => {
                const documentFragment = new DOMParser().parseFromString(html, 'text/html');
                const refreshedDashboard = documentFragment.querySelector('#inspector-dashboard');
                if (refreshedDashboard) {
                    $('#inspector-dashboard').html(refreshedDashboard.innerHTML);
                    if (message) showMessage(message);
                }
            }).fail(() => showMessage('The update succeeded, but the dashboard could not refresh. Reload the page to see the latest status.', true));

            const showFailure = xhr => showMessage(xhr.responseJSON?.message || 'The request could not be completed.', true);

            $('#inspector-dashboard').on('submit', '.js-inspector-claim-form', function (event) {
                event.preventDefault();
                const form = $(this);
                $.post(form.attr('action'), form.serialize())
                    .done(result => refreshDashboard(result.message))
                    .fail(showFailure);
            });

            $('#inspector-dashboard').on('submit', '.js-inspector-report-form', function (event) {
                event.preventDefault();
                const form = $(this);
                $.ajax({ url: form.attr('action'), method: 'POST', data: form.serialize() })
                    .done(result => refreshDashboard(result.message))
                    .fail(showFailure);
            });
        })();
    </script>
}
