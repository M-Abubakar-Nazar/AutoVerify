<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - AutoVerify</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- AutoVerify CSS -->
    <link rel="stylesheet" href="~/assets/css/style.css" asp-append-version="true" />

    <!-- AutoVerify Custom CSS -->
    <style>
        :root {
            --primary-blue: #1d3557;
            --primary-hover: #14243b;
            --navbar-bg: #ffffff;
            --header-text: #374151;
            --body-text: #475569;
            --charcoal-text: #1f2937;
            --light-bg: #f8fafc;
            --border-color: #e2e8f0;
            --green-accent: #1f7a4c;
            --green-hover: #165836;
            --teal-accent: #13b3a6;
        }

        body {
            background-color: #ffffff;
            color: var(--body-text);
        }

        .navbar-brand {
            color: var(--header-text);
            font-weight: 700;
        }

        h1,
        h2,
        h3,
        .section-title {
            color: var(--charcoal-text);
        }

        .text-primary,
        .hero h1 .text-primary {
            color: var(--primary-blue) !important;
        }

        .hero .text-secondary {
            color: var(--body-text) !important;
        }

        .btn-primary {
            background-color: var(--primary-blue);
            border-color: var(--primary-blue);
            color: #ffffff;
        }

        .btn-primary:hover {
            background-color: var(--primary-hover);
            border-color: var(--primary-hover);
            color: #ffffff;
        }

        .hero .btn-outline-light {
            background-color: var(--green-accent);
            border-color: var(--green-accent);
            color: #ffffff;
        }

        .hero .btn-outline-light:hover {
            background-color: var(--green-hover);
            border-color: var(--green-hover);
            color: #ffffff;
        }

        .search-widget {
            background-color: rgba(226, 232, 240, 0.5) !important;
            backdrop-filter: blur(4px);
        }

        .search-widget .text-muted {
            color: var(--body-text) !important;
        }

        .search-widget label.form-label {
            color: var(--charcoal-text);
        }

        .soft-card {
            border: 1px solid var(--border-color);
            background-color: #ffffff;
            border-radius: 0.75rem;
        }

        .soft-card .muted {
            color: var(--body-text) !important;
        }

        .soft-card h5 {
            color: var(--charcoal-text);
        }

        .feature-icon {
            color: var(--teal-accent);
            font-weight: 700;
        }

        .table {
            color: var(--body-text);
            border-color: var(--border-color);
        }

        .table thead th {
            color: var(--charcoal-text);
        }

        .table strong {
            color: var(--charcoal-text);
        }

        .status-yellow {
            background-color: #fef9c3;
            color: #a16207;
        }

        .status-green {
            background-color: #dcfce7;
            color: #15803d;
        }

        .status-blue {
            background-color: #dbeafe;
            color: var(--primary-blue);
        }

        .page-footer {
            color: var(--body-text);
            background-color: #ffffff;
            border-top: 1px solid var(--border-color);
        }
    </style>
</head>

<body>

    <!-- Main Navigation -->
    <nav class="navbar navbar-expand-lg bg-white border-bottom sticky-top">
        <div class="container py-2">

            <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index">
                <span class="brand-name fs-5">AutoVerify</span>
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                    aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNavbar">
                <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">
                            Home
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/#how-it-works">
                            How it works
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/#featured-cars">
                            Browse cars
                        </a>
                    </li>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item ms-lg-2">
                            <span class="nav-link">
                                Welcome, @User.Identity.Name
                            </span>
                        </li>

                        <li class="nav-item">
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                <button type="submit" class="btn btn-outline-danger px-3">
                                    Logout
                                </button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item ms-lg-2">
                            <a class="btn btn-outline-secondary px-3" asp-controller="Account" asp-action="Login">
                                Login
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="btn btn-primary px-3" asp-controller="Account" asp-action="Signup">
                                Create account
                            </a>
                        </li>
                    }

                </ul>
            </div>
        </div>
    </nav>

    <!-- Page Content -->
    @RenderBody()

    <!-- Footer -->
    <footer class="container page-footer border-top px-4 py-3 mt-5">
        <div class="d-flex flex-wrap justify-content-between gap-2">
            <span>© 2026 AutoVerify. University project demonstration.</span>
            <span>Used Car Marketplace & Inspection Management</span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>
