@{
    Layout = "_Layout";
}






<main>
    <section class="container py-4 py-lg-5 hero">
        <div class="p-4 p-md-5">
            <div class="row align-items-center g-4 py-lg-4">
                <div class="col-lg-7">
                    <div class="eyebrow mb-3" style="color: var(--body-text);">A smarter way to buy and sell</div>
                    <h1 class="display-4 mb-3">Find your next car with <span class="text-primary">more
                        confidence.</span></h1>
                        <p class="lead mb-4">Explore used cars, connect with sellers and request an independent vehicle
                            inspection through one organized platform.</p>
                            <div class="d-flex flex-wrap gap-2">
                                <a href="#featured-cars" class="btn btn-primary btn-lg px-4">Explore cars</a>
                                <a href="signup.html" class="btn btn-outline-light btn-lg px-4">Get started</a>
                            </div>
                            <div class="d-flex flex-wrap gap-4 mt-4 small text-secondary">
                                <span>✓ Independent inspections</span>
                                <span>✓ Clear vehicle details</span>
                                <span>✓ Simple process</span>
                            </div>
                        </div>
                        <div class="col-lg-5 d-none d-lg-block">
                            <div class="p-3 rounded-4 search-widget">
                                <div class="small text-uppercase mb-2"
                                     style="color: var(--teal-accent); letter-spacing: 1px; font-weight: 600;">Start your
                                    search</div>
                                    <div class="bg-white text-dark rounded-3 p-3">
                                        <label class="form-label">Make or model</label>
                                        <input class="form-control mb-3" placeholder="e.g. Toyota Corolla">
                                        <div class="row g-2">
                                            <div class="col-6">
                                                <label class="form-label">Min. price</label>
                                                <select class="form-select">
                                                    <option>Any</option>
                                                    <option>PKR 10 lac</option>
                                                    <option>PKR 20 lac</option>
                                                </select>
                                            </div>
                                            <div class="col-6">
                                                <label class="form-label">Max. price</label>
                                                <select class="form-select">
                                                    <option>Any</option>
                                                    <option>PKR 30 lac</option>
                                                    <option>PKR 50 lac</option>
                                                </select>
                                            </div>
                                        </div>
                                        <a href="#featured-cars" class="btn btn-primary w-100 mt-3">Search vehicles</a>
                                        <div class="text-muted small mt-2">search interface — listings below.</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="container pb-5" id="how-it-works">
                    <div class="text-center mb-4">
                        <div class="fw-bold small text-uppercase" style="color: var(--teal-accent);">How AutoVerify works</div>
                        <h2 class="section-title mt-2">A more organized car buying journey</h2>
                        <p class="muted">Browse, request an inspection and review a structured report.</p>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="soft-card p-4">
                                <div class="feature-icon mb-3">01</div>
                                <h5 class="fw-bold">Browse vehicles</h5>
                                <p class="muted mb-0">Explore available used cars and review their details, price and
                                    photographs.</p>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="soft-card p-4">
                                    <div class="feature-icon mb-3">02</div>
                                    <h5 class="fw-bold">Request inspection</h5>
                                    <p class="muted mb-0">Request an independent inspection and wait for the seller to approve
                                        access.</p>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="soft-card p-4">
                                        <div class="feature-icon mb-3">03</div>
                                        <h5 class="fw-bold">Review the report</h5>
                                        <p class="muted mb-0">Review the inspector's observations, checklist results and supporting
                                            photographs.</p>
                                        </div>
                                    </div>
                                </div>
                            </section>

                            <section class="container pb-5" id="featured-cars">
                                <div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-4">
                                    <div>
                                        <div class="fw-bold small text-uppercase" style="color: var(--teal-accent);">Sample inventory</div>
                                        <h2 class="section-title mb-0">Featured vehicles</h2>
                                    </div>
                                    <span class="muted small">Illustrative dummy listings</span>
                                </div>
                                <div class="row g-4">
                                    <!-- Vehicle 1: Toyota Corolla -->
                                    <div class="col-md-6 col-lg-4">
                                        <article class="soft-card h-100 overflow-hidden">
                                            <img class="w-100" style="height: 200px; object-fit: cover;" src="/assets/images/corolla.png"
                                                 alt="Black Toyota Corolla 2023">
                                            <div class="p-3">
                                                <div class="d-flex justify-content-between align-items-center mb-2">
                                                    <span class="badge text-bg-light border">2026</span>
                                                    <span class="badge status-green">Available</span>
                                                </div>
                                                <h5 class="fw-bold text-dark mb-1">Toyota Corolla Altis</h5>
                                                <p class="muted small mb-2">1.6L • Automatic • 15,000 km</p>
                                                <div class="d-flex justify-content-between align-items-center mt-3">
                                                    <span class="car-price" style="color: var(--primary-blue); font-weight: 700;">PKR
                                                        6,100,000</span>
                                                        <a href="login.html" class="btn btn-sm btn-outline-secondary"
                                                           style="color: var(--primary-blue); border-color: var(--border-color);">View
                                                            details</a>
                                                        </div>
                                                    </div>
                                                </article>
                                            </div>

                                            <!-- Vehicle 2: Honda Civic -->
                                            <div class="col-md-6 col-lg-4">
                                                <article class="soft-card h-100 overflow-hidden">
                                                    <img class="w-100" style="height: 200px; object-fit: cover;" src="/assets/images/civic.png"
                                                         alt="Grey Honda Civic 2022">
                                                    <div class="p-3">
                                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                                            <span class="badge text-bg-light border">2022</span>
                                                            <span class="badge status-green">Available</span>
                                                        </div>
                                                        <h5 class="fw-bold text-dark mb-1">Honda Civic Oriel</h5>
                                                        <p class="muted small mb-2">1.5L Turbo • Automatic • 28,000 km</p>
                                                        <div class="d-flex justify-content-between align-items-center mt-3">
                                                            <span class="car-price" style="color: var(--primary-blue); font-weight: 700;">PKR
                                                                5,200,000</span>
                                                                <a href="login.html" class="btn btn-sm btn-outline-secondary"
                                                                   style="color: var(--primary-blue); border-color: var(--border-color);">View
                                                                    details</a>
                                                                </div>
                                                            </div>
                                                        </article>
                                                    </div>

                                                    <!-- Vehicle 3: Kia Sportage -->
                                                    <div class="col-md-6 col-lg-4">
                                                        <article class="soft-card h-100 overflow-hidden">
                                                            <img class="w-100" style="height: 200px; object-fit: cover;" src="/assets/images/kia.png"
                                                                 alt="White Kia Sportage">
                                                            <div class="p-3">
                                                                <div class="d-flex justify-content-between align-items-center mb-2">
                                                                    <span class="badge text-bg-light border">2021</span>
                                                                    <span class="badge status-yellow">Inspection Pending</span>
                                                                </div>
                                                                <h5 class="fw-bold text-dark mb-1">Kia Sportage Alpha</h5>
                                                                <p class="muted small mb-2">2.0L • Automatic • 42,000 km</p>
                                                                <div class="d-flex justify-content-between align-items-center mt-3">
                                                                    <span class="car-price" style="color: var(--primary-blue); font-weight: 700;">PKR
                                                                        7,000,000</span>
                                                                        <a href="login.html" class="btn btn-sm btn-outline-secondary"
                                                                           style="color: var(--primary-blue); border-color: var(--border-color);">View
                                                                            details</a>
                                                                        </div>
                                                                    </div>
                                                                </article>
                                                            </div>
                                                        </div>
                                                    </section>

                                                    <section class="container pb-5">
                                                        <div class="border rounded p-4 p-md-5" style="background-color: var(--light-bg);">
                                                            <div class="row align-items-center g-3">
                                                                <div class="col-lg-8">
                                                                    <h2 class="fw-bold">Ready to get started?</h2>
                                                                    <p class="mb-0 text-secondary">Create an account to explore the AutoVerify experience.</p>
                                                                </div>
                                                                <div class="col-lg-4 text-lg-end">
                                                                    <a href="signup.html" class="btn btn-primary btn-lg px-4">Create free account</a>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </section>
                                                </main>

                                                   

                                                  