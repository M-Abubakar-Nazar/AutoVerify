@model AutoVerifyMVC.Models.CarListingPageViewModel
@{
    ViewData["Title"] = "Home";
}

<main>
    <section class="container py-4 py-lg-5 hero">
        <div class="p-4 p-md-5">
            <div class="row align-items-center g-4 py-lg-4">
                <div class="col-lg-7">
                    <div class="eyebrow mb-3">A smarter way to buy and sell</div>
                    <h1 class="display-4 mb-3">Find your next car with <span class="text-primary">more confidence.</span></h1>
                    <p class="lead mb-4">Explore used cars, connect with sellers and request an independent vehicle inspection through one organized platform.</p>
                    <div class="d-flex flex-wrap gap-2">
                        <a href="#featured-cars" class="btn btn-primary btn-lg px-4">Explore cars</a>
                        <a class="btn btn-outline-light btn-lg px-4" asp-controller="Account" asp-action="Signup">Get started</a>
                    </div>
                    <div class="d-flex flex-wrap gap-4 mt-4 small text-secondary">
                        <span>✓ Independent inspections</span><span>✓ Clear vehicle details</span><span>✓ Simple process</span>
                    </div>
                </div>
                <div class="col-lg-5">
                    <form id="home-search-form" class="p-3 rounded-4 search-widget">
                        <div class="small text-uppercase mb-2 fw-semibold">Start your search</div>
                        <div class="bg-white text-dark rounded-3 p-3">
                            <label class="form-label" for="home-search-term">Make or model</label>
                            <input id="home-search-term" name="searchTerm" class="form-control mb-3" placeholder="e.g. Toyota Corolla" />
                            <label class="form-label" for="home-price-range">Price range</label>
                            <select id="home-price-range" name="priceRange" class="form-select">
                                <option value="">Any price</option><option value="under-20">Under 20 Lakh</option><option value="20-30">20–30 Lakh</option><option value="30-40">30–40 Lakh</option><option value="40-50">40–50 Lakh</option><option value="50-70">50–70 Lakh</option><option value="70-90">70–90 Lakh</option><option value="90-120">90–120 Lakh</option><option value="120-plus">Over 120 Lakh</option>
                            </select>
                            <button class="btn btn-primary w-100 mt-3" type="submit">Search vehicles</button>
                            <div id="home-search-feedback" class="small text-danger mt-2" role="status"></div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <section class="container pb-5" id="how-it-works">
        <div class="text-center mb-4">
            <div class="fw-bold small text-uppercase text-accent">How AutoVerify works</div>
            <h2 class="section-title mt-2">A more organized car buying journey</h2>
            <p class="muted">Browse, request an inspection and review a structured report.</p>
        </div>
        <div class="row g-3">
            <div class="col-md-4"><div class="soft-card p-4 h-100"><div class="feature-icon mb-3">01</div><h3 class="h5 fw-bold">Browse vehicles</h3><p class="muted mb-0">Explore available used cars and review their details, price and photographs.</p></div></div>
            <div class="col-md-4"><div class="soft-card p-4 h-100"><div class="feature-icon mb-3">02</div><h3 class="h5 fw-bold">Request inspection</h3><p class="muted mb-0">Send an inspection request to the seller and follow its status in your dashboard.</p></div></div>
            <div class="col-md-4"><div class="soft-card p-4 h-100"><div class="feature-icon mb-3">03</div><h3 class="h5 fw-bold">Review the report</h3><p class="muted mb-0">Review the inspector's observations, checklist results and supporting photographs.</p></div></div>
        </div>
    </section>

    <section class="container pb-5" id="featured-cars">
        <div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-4">
            <div><div class="fw-bold small text-uppercase text-accent">Vehicle marketplace</div><h2 class="section-title mb-0">Featured vehicles</h2></div>
            <span id="home-result-count" class="muted small">Showing @Model.Cars.Count vehicles</span>
        </div>
        <div id="home-car-results">@await Html.PartialAsync("_HomeCarCards", Model)</div>
        <div class="text-center mt-4"><button id="load-more-cars" class="btn btn-outline-primary px-4" type="button" hidden>Show more cars</button></div>
    </section>

    <section class="container pb-5">
        <div class="soft-card p-4 p-md-5">
            <div class="row align-items-center g-3">
                <div class="col-lg-8"><h2 class="fw-bold">Ready to get started?</h2><p class="mb-0 text-secondary">Create an account to explore vehicles and request inspections.</p></div>
                <div class="col-lg-4 text-lg-end"><a class="btn btn-primary btn-lg px-4" asp-controller="Account" asp-action="Signup">Create free account</a></div>
            </div>
        </div>
    </section>
</main>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script>
        (() => {
            const searchUrl = '@Url.Action("SearchCars", "Home")', loadUrl = '@Url.Action("LoadMoreCars", "Home")', statusUrl = '@Url.Action("CarStatuses", "Home")';
            const results = $('#home-car-results'), button = $('#load-more-cars'); let skip = @Model.Cars.Count;
            const filter = () => $('#home-search-form').serialize();
            const refreshButton = () => button.prop('hidden', results.find('.home-car-card').length === 0 || results.find('#home-car-page').attr('data-has-more') !== 'true');
            $('#home-search-form').on('submit', event => {
                event.preventDefault(); $('#home-search-feedback').text(''); button.prop('disabled', true);
                $.get(searchUrl, filter()).done(html => { results.html(html); skip = results.find('.home-car-card').length; $('#home-result-count').text(`Showing ${skip} vehicles`); refreshButton(); })
                    .fail(() => $('#home-search-feedback').text('Could not load vehicles.')).always(() => button.prop('disabled', false));
            });
            button.on('click', () => {
                button.prop('disabled', true).text('Loading…');
                $.get(loadUrl, `${filter()}&skip=${skip}`).done(html => {
                    const page = $(html), cards = page.find('.home-car-card'), wrapper = results.find('#home-car-page');
                    wrapper.append(cards).attr('data-has-more', page.filter('#home-car-page').attr('data-has-more'));
                    skip += cards.length; $('#home-result-count').text(`Showing ${skip} vehicles`); refreshButton();
                }).fail(() => $('#home-search-feedback').text('Could not load more vehicles.'))
                  .always(() => button.prop('disabled', false).text('Show more cars'));
            });
            const badgeClass = s => s === 'Sold' ? 'text-bg-danger' : s === 'Unavailable' ? 'text-bg-secondary' : s === 'Reserved' ? 'text-bg-warning' : 'text-bg-success';
            const syncStatuses = () => $.get(statusUrl).done(items => items.forEach(item => {
                const badge = $(`[data-car-status-id="${item.id}"]`); if (!badge.length) return;
                badge.text(item.status).removeClass('text-bg-danger text-bg-secondary text-bg-warning text-bg-success').addClass(badgeClass(item.status));
                const slot = badge.closest('.home-car-card').find(`[data-request-slot="${item.id}"]`);
                if (item.status !== 'Available') slot.empty();
                else if (item.sellerId && !slot.find('a').length) slot.html(`<a class="btn btn-sm btn-outline-secondary" data-request-link="${item.id}" href="@Url.Action("Login", "Account")">Request inspection</a>`);
            }));
            refreshButton(); syncStatuses(); window.setInterval(syncStatuses, 10000);
        })();
    </script>
}
