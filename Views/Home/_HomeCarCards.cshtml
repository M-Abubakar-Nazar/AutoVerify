@model AutoVerifyMVC.Models.CarListingPageViewModel
<div id="home-car-page" class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4" data-has-more="@Model.HasMore.ToString().ToLowerInvariant()">
    @if (Model.Cars.Count == 0)
    {
        <div class="col-12"><div class="alert alert-light border">No vehicles match your search.</div></div>
    }
    else
    {
        foreach (var car in Model.Cars)
        {
            var defaultImageUrl = Url.Content("~/assets/images/Default.png");
            var imageUrl = string.IsNullOrWhiteSpace(car.ImagePath) ? defaultImageUrl : car.ImagePath;
            var badgeClass = car.Status switch
            {
                "Sold" => "text-bg-danger",
                "Unavailable" => "text-bg-secondary",
                "Reserved" => "text-bg-warning",
                _ => "text-bg-success"
            };
            <div class="home-car-card col d-flex" data-car-id="@car.Id" data-seller-id="@car.SellerId">
                <article class="soft-card h-100 w-100 d-flex flex-column overflow-hidden">
                    <img class="w-100 flex-shrink-0" style="height:210px;object-fit:cover" src="@imageUrl" onerror="this.onerror=null;this.src='@defaultImageUrl';" alt="@car.ModelYear @car.Make @car.Model @car.Trim" />
                    <div class="p-3 d-flex flex-column flex-grow-1">
                        <div class="d-flex justify-content-between gap-2 align-items-center mb-2">
                            <span class="badge text-bg-light border">@car.ModelYear</span>
                            <span class="badge status-badge @badgeClass" data-car-status-id="@car.Id">@car.Status</span>
                        </div>
                        <h3 class="h5 fw-bold text-dark">@car.ModelYear @car.Make @car.Model @car.Trim</h3>
                        <p class="small text-muted mb-2">@car.Engine · @car.Transmission · @car.MileageKm.ToString("N0") km · @car.FuelType</p>
                        <p class="car-description-summary mb-2">@car.Description</p>
                        <details class="mb-3">
                            <summary class="small text-primary">Full details</summary>
                            <p class="small mt-2 mb-0">@car.Description</p>
                        </details>
                        <div class="d-flex justify-content-between align-items-center mt-auto pt-3">
                            <strong class="text-primary">PKR @car.Price.ToString("N0")</strong>
                            <span data-request-slot="@car.Id">
                                @if (car.Status == "Available" && car.SellerId != null)
                                {
                                    <a class="btn btn-sm btn-outline-secondary" data-request-link="@car.Id" asp-controller="Account" asp-action="Login">Request inspection</a>
                                }
                            </span>
                        </div>
                    </div>
                </article>
            </div>
        }
    }
</div>
